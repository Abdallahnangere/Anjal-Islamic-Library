{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://islamiclibrary.anjalventures.com/schemas/hadith_collections.schema.json",
  "title": "Hadith Collection Summary Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "collection_key",
    "collection_name",
    "arabic_count",
    "english_count",
    "merged_count"
  ],
  "properties": {
    "collection_key": { "type": "string", "minLength": 1 },
    "collection_name": { "type": "string", "minLength": 1 },
    "arabic_edition": { "type": ["string", "null"] },
    "english_edition": { "type": ["string", "null"] },
    "arabic_count": { "type": ["integer", "null"], "minimum": 0 },
    "english_count": { "type": ["integer", "null"], "minimum": 0 },
    "merged_count": { "type": ["integer", "null"], "minimum": 0 },
    "arabic_author": { "type": ["string", "null"] },
    "english_author": { "type": ["string", "null"] }
  }
}
