{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://islamiclibrary.anjalventures.com/schemas/hijri_dates.schema.json",
  "title": "Umm al-Qura Hijri Date Mapping Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rjd",
    "hijri_year",
    "hijri_month",
    "hijri_day",
    "hijri_iso",
    "gregorian_year",
    "gregorian_month",
    "gregorian_day",
    "gregorian_iso"
  ],
  "properties": {
    "rjd": { "type": "integer" },
    "hijri_year": { "type": "integer", "minimum": 1343, "maximum": 1500 },
    "hijri_month": { "type": "integer", "minimum": 1, "maximum": 12 },
    "hijri_day": { "type": "integer", "minimum": 1, "maximum": 30 },
    "hijri_iso": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "gregorian_year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
    "gregorian_month": { "type": "integer", "minimum": 1, "maximum": 12 },
    "gregorian_day": { "type": "integer", "minimum": 1, "maximum": 31 },
    "gregorian_iso": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
